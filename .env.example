# ── Supabase Auth（Google 登录）────────────────
# 从 Supabase 项目 Settings → API 获取。anon key 是公开的（受 RLS 保护），
# 前端用 VITE_ 前缀暴露。不配置时登录按钮不渲染。
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Supabase 服务端（后端用，绝不放前端）─────
# service_role key 有完全权限，只在 api/*.ts 服务端使用，验证 JWT + 写库。
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Provider 选择 ─────────────────────────────
# 默认风格转换 provider（本地开发建议 mock，无需 key；生产默认 replicate → FLUX）
IMAGE_PROVIDER=replicate

# ── Replicate（模型平台，图生图）───────────────
REPLICATE_API_TOKEN=r8_...
# 模型由 api/providers/models.ts 的「模型注册表」管理，每个模型有自己的输入
# schema（图片键名、数组/单值、固定参数）。style 通过 generation_config 里的
# providerOverrides.replicate.model 指定 modelId（如 "nano-banana-2"），
# 不指定时用默认模型 flux-kontext-pro。
#
# 默认模型（FLUX Kontext Pro）的版本 hash：
# REPLICATE_MODEL_VERSION=64位版本hash
#
# gpt-image 模型（模型注册表 "gpt-image"）的模型与版本：
# OPENAI_REPLICATE_MODEL=openai/gpt-image-1
# OPENAI_REPLICATE_MODEL_VERSION=64位版本hash

# ── 阿里云百炼 ModelStudio / 通义万相 ──────────
DASHSCOPE_API_KEY=sk-...

# ── 火山方舟 Ark（即梦 Seedream / 豆包）────────
ARK_API_KEY=...
# ARK_EDIT_MODEL=doubao-seededit-3-0-i2i-250628   # 图生图/风格转换模型

# 异步生成（POST /api/generate）：Replicate 完成后回调此地址，让图片更快落地
# （不设置则客户端轮询 GET /api/generate?id=… 兜底）
# REPLICATE_WEBHOOK_URL=https://your-app.vercel.app/api/replicate-webhook

# Create Style 表单的预设模型列表（JSON 数组，GET /api/models 返回给前端）
# 格式 [{"id":"owner/name","label":"显示名"},...]
REPLICATE_MODELS=[{"id":"timbrooks/instruct-pix2pix","label":"Instruct Pix2Pix"},{"id":"stability-ai/stable-diffusion-img2img","label":"Stable Diffusion Img2Img"}]

# ── Lemon Squeezy 支付（二期启用，当前占位）──────
# 支付成功后由 /api/ls-webhook（HMAC 验签 + 幂等发额）驱动订阅与 Generations
LS_API_KEY=le_...
LS_STORE_ID=...
# 套餐对应 variant id（API → Settings → Variants）
LS_VARIANT_PLUS_ID=...
LS_VARIANT_PRO_ID=...
# Webhook Secret（Lemon Squeezy Settings → Webhooks → Signing secret）
LS_WEBHOOK_SECRET=...

# ── Style 审核管理员 ─────────────────────────
# 逗号分隔邮箱，允许调用 POST /api/style-review 批准社区投稿
# STYLE_ADMIN_EMAILS=admin@example.com

# ── 运行 ──────────────────────────────────────
# 单个 provider 调用超时预算（毫秒），需小于 Vercel 函数 maxDuration
# GENERATE_TIMEOUT_MS=55000
