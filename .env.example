# ── Supabase Auth（Google 登录）────────────────
# 从 Supabase 项目 Settings → API 获取。anon key 是公开的（受 RLS 保护），
# 前端用 VITE_ 前缀暴露。不配置时登录按钮不渲染。
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Supabase 服务端（后端用，绝不放前端）─────
# service_role key 有完全权限，只在 api/*.ts 服务端使用，验证 JWT + 写库。
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Provider 选择 ─────────────────────────────
# 默认风格转换 provider（本地开发建议 mock，无需 key）
IMAGE_PROVIDER=mock

# ── OpenAI（gpt-image-1 edits）─────────────────
OPENAI_API_KEY=sk-...

# ── 阿里云百炼 ModelStudio / 通义万相 ──────────
DASHSCOPE_API_KEY=sk-...

# ── 火山方舟 Ark（即梦 Seedream / 豆包）────────
ARK_API_KEY=...
# ARK_EDIT_MODEL=doubao-seededit-3-0-i2i-250628   # 图生图/风格转换模型

# ── Replicate（模型平台，图生图）───────────────
REPLICATE_API_TOKEN=r8_...
# 默认模型（可被 style 的 providerOverrides.replicate 覆盖）
# 格式 "owner/name" 或 "owner/name:version"
# REPLICATE_MODEL=owner/model
# 或指定精确版本 hash（优先级高于 REPLICATE_MODEL）
# REPLICATE_MODEL_VERSION=64位版本hash

# Create Style 表单的预设模型列表（JSON 数组，GET /api/models 返回给前端）
# 格式 [{"id":"owner/name","label":"显示名"},...]
REPLICATE_MODELS=[{"id":"timbrooks/instruct-pix2pix","label":"Instruct Pix2Pix"},{"id":"stability-ai/stable-diffusion-img2img","label":"Stable Diffusion Img2Img"}]

# ── 运行 ──────────────────────────────────────
# 单个 provider 调用超时预算（毫秒），需小于 Vercel 函数 maxDuration
# GENERATE_TIMEOUT_MS=55000
