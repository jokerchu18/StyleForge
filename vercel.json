{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "functions": {
    "api/transform.ts": { "maxDuration": 60, "memory": 1024 },
    "api/health.ts": { "maxDuration": 10, "memory": 256 },
    "api/styles.ts": { "maxDuration": 10, "memory": 256 },
    "api/models.ts": { "maxDuration": 10, "memory": 256 }
  }
}
